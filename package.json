{
  "name": "mcp-leclerc-drive",
  "version": "0.4.0",
  "mcpName": "io.github.skunkobi/leclerc-drive",
  "description": "MCP server for E.Leclerc Drive — search products, manage cart, and order groceries from Claude",
  "type": "module",
  "bin": {
    "mcp-leclerc-drive": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "import": "node scripts/import-history.mjs",
    "bundle": "bash scripts/build-bundle.sh"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "leclerc",
    "leclerc-drive",
    "grocery",
    "courses"
  ],
  "author": "skunkobi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skunkobi/mcp-leclerc-drive.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
